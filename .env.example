# Komma-getrennte Liste der zu trackenden Twitch-Kanaele (ohne #)
CHANNELS=kanalname1,kanalname2

# Optionaler Twitch-Bot-Account fuer die IRC-Verbindung.
# Kann leer bleiben -> dann wird anonym gelesen (nur Lesezugriff, kein Chatten noetig)
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=

# Zusaetzliche, konfigurierbare Bot-Namen (Komma-getrennt), die NICHT gezaehlt werden sollen.
# Die gaengigsten (streamelements, nightbot, moobot, fossabot, wizebot, streamlabs)
# sind bereits fest eingebaut und muessen hier nicht wiederholt werden.
EXTRA_BOT_BLOCKLIST=

# Alle wie viele Sekunden der In-Memory-Stand atomar auf Platte geschrieben wird
FLUSH_INTERVAL_SECONDS=20

# Port des HTTP-Endpunkts
PORT=3000

# Verzeichnis fuer die JSON-Dateien (im Container per Volume mounten!)
DATA_DIR=./data
